<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      直连引擎用的权限。注意：
      WRITE_SMS / WRITE_CALL_LOG 在 Android 10+ 属于受限权限，
      普通签名安装的应用实际拿不到（由 AMS 在 provider 解析阶段拒绝），
      所以这里声明只是「万一 ROM 允许 / 用户自行授权」时能走直连；
      真正稳定的是模块引擎（在 provider 进程内执行）与 root 引擎。
    -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.WRITE_SMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- 模块桥接专用签名级权限：只有同签名应用才能拉起 provider 进程里的执行器 -->
    <permission
        android:name="cn.ftqp.callsms.permission.BRIDGE"
        android:protectionLevel="signature" />
    <uses-permission android:name="cn.ftqp.callsms.permission.BRIDGE" />

    <!-- Android 11+ 包可见性：要能判断 LSPosed 管理器在不在、能不能直接拉起来 -->
    <queries>
        <package android:name="org.lsposed.manager" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:description="@string/app_description"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SetupActivity"
            android:exported="false"
            android:label="配置与诊断"
            android:parentActivityName=".ui.MainActivity" />
    </application>
</manifest>
